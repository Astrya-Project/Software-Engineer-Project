rules_version = '2';

service cloud.firestore {
    match/databases/{database}/documents {

        // Helper functions

        // Returns true if the caller is authenticated
        function isSignedIn() {
            return request.auth != null;
        }

        // Returns the caller's role stored in their user document
        function getRole() {
            return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
        }

        // Role checks
        function isAdmin() { return isSignedIn() && getRole() == 'admin'; }
        function isPlanner() { return isSignedIn() && getRole() == 'planner'; }
        function isClient() { return isSignedIn() && getRole() == 'client'; }
        function isGuest() { return isSignedIn() && getRole() == 'guest'; }

        // True if the caller owns this event (their uid matches the ownerId field)
        function ownsEvent(eventId) {
            return get(/databases/$(database)/documents/events/$(eventId)).data.ownerId == request.auth.uid;
        }

        // /users/{userId}

        match/users/{userId} {
      // Anyone can create their own user doc on signup
      allow create: if isSignedIn() && request.auth.uid == userId;

      // Users can read/update their own profile; admin can read/update any
      allow read, update: if isSignedIn() &&
                (request.auth.uid == userId || isAdmin());

      // Only admin can delete user records
      allow delete: if isAdmin();

      // Prevent clients from promoting themselves to admin/planner
      allow update: if isSignedIn() && request.auth.uid == userId &&
                !('role' in request.resource.data) ||
                request.resource.data.role == resource.data.role;
        }

        // /events/{eventId}

        match/events/{eventId} {
      // Admin and planner can read all events; clients read only their own
      allow read: if isAdmin() || isPlanner() ||
                (isClient() && resource.data.ownerId == request.auth.uid);

      // Clients can create events (they become the owner)
      allow create: if isClient() && request.resource.data.ownerId == request.auth.uid;

      // Owner, planner, and admin can update
      allow update: if isAdmin() || isPlanner() ||
                (isClient() && resource.data.ownerId == request.auth.uid);

      // Only admin or planner can delete events
      allow delete: if isAdmin() || isPlanner();

            // ── /events/{eventId}/guests/{guestId} ──────
            match/guests/{guestId} {
        // Event owner, planner, admin can read/write guests
        allow read, write: if isAdmin() || isPlanner() || ownsEvent(eventId);

        // Guests can read their own record and update RSVP fields only
        allow read: if isGuest() && resource.data.userId == request.auth.uid;
        allow update: if isGuest() &&
                    resource.data.userId == request.auth.uid &&
                    request.resource.data.diff(resource.data).affectedKeys()
                        .hasOnly(['rsvpStatus', 'plusOne', 'plusOneName',
                            'dietaryRestrictions', 'message', 'updatedAt']);
            }

            // ── /events/{eventId}/budgetItems/{itemId} ──
            match/budgetItems/{itemId} {
        allow read, write: if isAdmin() || isPlanner() || ownsEvent(eventId);
            }

            // ── /events/{eventId}/messages/{messageId} ──
            match/messages/{messageId} {
        // Event owner, planner, admin can read all messages
        allow read: if isAdmin() || isPlanner() || ownsEvent(eventId);
        // Any participant in the event may write a message
        allow create: if isSignedIn() &&
                    (isAdmin() || isPlanner() || ownsEvent(eventId));
        // No one edits sent messages (immutable log)
        allow update, delete: if false;
            }
        }

        // /vendors/{vendorId}

        match/vendors/{vendorId} {
      // All authenticated users can read the vendor directory
      allow read: if isSignedIn();

      // Only admin or planner can create/edit/delete vendors
      allow create, update, delete: if isAdmin() || isPlanner();
        }

        // /rsvpTokens/{token}

        // Lookup table so a guest can find their event via a unique invite link
        match/rsvpTokens/{token} {
      // Anyone (even unauthenticated) can read a token to bootstrap the RSVP flow
      allow read: if true;
      // Only the system (admin/planner) can create tokens
      allow create, delete: if isAdmin() || isPlanner();
      allow update: if false;
        }

        // /systemConfig/{docId}

        match/systemConfig/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
        }
    }
}